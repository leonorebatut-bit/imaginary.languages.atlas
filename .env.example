# Aucune clé secrète n'est nécessaire à ce stade.
# Copier ce fichier en .env pour surcharger la configuration locale.

# Agent HTTP envoyé aux sources (générique, sans donnée personnelle)
ATLAS_USER_AGENT=imaginary-languages-atlas/0.1 (research pipeline)

